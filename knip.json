{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/index.ts", "src/test-server.ts"],
  "project": ["src/**/*.ts", "tests/**/*.ts"],
  "ignore": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "scripts/**",
    "public/**",
    "src/public/**",
    "tests/setup-deckbuilding.ts"
  ],
  "ignoreBinaries": ["wait"],
  "ignoreDependencies": ["jest-environment-jsdom"]
}
