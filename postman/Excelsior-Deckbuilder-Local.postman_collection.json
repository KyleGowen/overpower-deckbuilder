{
  "info": {
    "name": "Excelsior Deckbuilder (Local)",
    "description": "Local API collection for Excelsior / Overpower Deckbuilder.\n\nSetup: Run npm run dev (default port 8085).\n\nAuth: Run \"POST /api/auth/login\" first; Postman stores the sessionId cookie for localhost:8085. Local admin test user: kyle / test (see project conventions).\n\nVariables: Set deckId, cardId, guestDeckId, userId from API responses after creating resources. Guest deck routes require a GUEST session (log in as guest in the app or use a guest session), not USER.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "excelsior-local-api"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "deckId",
      "value": "REPLACE_WITH_DECK_UUID"
    },
    {
      "key": "cardId",
      "value": "REPLACE_WITH_CARD_UUID"
    },
    {
      "key": "guestDeckId",
      "value": "REPLACE_WITH_GUEST_DECK_ID"
    },
    {
      "key": "userId",
      "value": "REPLACE_WITH_USER_UUID"
    }
  ],
