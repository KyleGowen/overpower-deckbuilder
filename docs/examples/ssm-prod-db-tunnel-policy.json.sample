{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SSMStartSessionToAppInstance",
      "Effect": "Allow",
      "Action": ["ssm:StartSession"],
      "Resource": [
        "arn:aws:ec2:us-west-2:REPLACE_AWS_ACCOUNT_ID:instance/REPLACE_EC2_INSTANCE_ID",
        "arn:aws:ssm:us-west-2::document/AWS-StartPortForwardingSessionToRemoteHost"
      ]
    },
    {
      "Sid": "SSMDescribeAndTerminateOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeSessions",
        "ssm:GetConnectionStatus",
        "ssm:DescribeInstanceProperties",
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "*"
    }
  ]
}
