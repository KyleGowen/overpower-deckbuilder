# Terraform variables example
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars with real secrets.

# Firebase (for Google Sign-In)
# Copy these values from Firebase Console -> Project settings -> Your apps -> Config (SDK snippet)
firebase_api_key     = "YOUR_FIREBASE_API_KEY"
firebase_auth_domain = "YOUR_PROJECT_ID.firebaseapp.com"
firebase_project_id  = "YOUR_PROJECT_ID"
firebase_app_id      = "YOUR_FIREBASE_APP_ID"

# Service account: Place the JSON file at infra/firebase-service-account.json (gitignored).
# Pass it when running terraform apply:
#   terraform apply -var "firebase_service_account_json=$(cat infra/firebase-service-account.json)"
# Leave empty below; do NOT paste raw JSON in tfvars.
firebase_service_account_json = ""

# CI/CD (GitHub Actions): IAM username for the deploy user. Required for the sync-images job
# (Sync Card Images to S3). Set to the user whose access keys are in AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY. Run: aws iam list-users --query 'Users[*].UserName'
# ci_iam_username = "github-actions-deploy"
